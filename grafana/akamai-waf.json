{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "DG Loki",
      "description": "Existing Loki data source",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "uid": "dg-akamai-waf",
  "title": "DG Monitoring | Akamai WAF",
  "description": "Security events only. Loki time is ingestion time; original event timestamp and lag are preserved. Synthetic lab.",
  "tags": [
    "akamai",
    "waf",
    "lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "WAF events · selected period",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({source=\"akamai\",dataset=\"waf\"}[$__range])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Denied events · selected period",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({source=\"akamai\",dataset=\"waf\",action=~\"deny|block\"}[$__range])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Security EPS · rolling 1m",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({source=\"akamai\",dataset=\"waf\"}[1m])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Invalid records · selected period",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({source=\"akamai\",dataset=\"diagnostic\"}[$__range])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Security event rate by applied action",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action) (rate({source=\"akamai\",dataset=\"waf\"}[1m]))",
          "queryType": "range",
          "legendFormat": "{{action}}",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Ingestion lag p95 (source → collector)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {source=\"akamai\",dataset=\"waf\"} | json | event_time_valid=\"true\" | unwrap ingestion_lag_seconds | __error__=\"\" [5m])",
          "queryType": "range",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Top ASN · selected period",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10,sum by (asn) (count_over_time({source=\"akamai\",dataset=\"waf\"} | json | asn!=\"\" | __error__=\"\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{asn}}",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Top source countries · selected period",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10,sum by (country) (count_over_time({source=\"akamai\",dataset=\"waf\"} | json | country!=\"\" | __error__=\"\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{country}}",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Normalized security events",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{source=\"akamai\",dataset=\"waf\"}",
          "queryType": "range",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 10,
      "title": "Collector diagnostics (no raw payload)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{source=\"akamai\",dataset=\"diagnostic\"}",
          "queryType": "range",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
